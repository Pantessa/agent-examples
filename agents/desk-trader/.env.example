# The agent's own key. Unset = a fresh throwaway, minted per run, holding
# nothing — which is why the default run is safe. Pantessa never sees this.
AGENT_KEY=

# Arm it. Real signatures, real broadcasts, real money. Refuses a generated key.
LIVE=

# The desk. Point at a local `next start` to develop against your own build.
PANTESSA_BASE=https://www.pantessa.com

# The sentence. broker_execute compiles SEQUENCED flows only — see the README.
ASK=

# Your desk identity: the desk publishes your track record at /agents/<sha256>.
AGENT_DESK_KEY=
AGENT_NAME=desk-trader
