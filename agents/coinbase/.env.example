# Copy to .env — never commit .env.

# ── Trade execution gate ─────────────────────────────────────────────────────
# Unset = DRY-RUN: orders are previewed, never placed; portfolio is a sample.
# Set to 1 (with real CDP keys below) to read the real portfolio and ARM real
# order placement.
LIVE=

# ── Coinbase Advanced Trade (CDP) API key ────────────────────────────────────
# Create at portal.cdp.coinbase.com → API keys (Advanced Trade scope).
# Key name, e.g. organizations/{org_id}/apiKeys/{key_id}
COINBASE_API_KEY_NAME=
# EC private key, SEC1 PEM ("-----BEGIN EC PRIVATE KEY-----") or PKCS8.
# Paste with real newlines, or with \n escapes (we normalize them).
COINBASE_API_PRIVATE_KEY=

# Product the agent watches/trades by default.
COINBASE_PRODUCT=BTC-USD

# ── The market signal the agent pays for (its x402 expense account) ───────────
# Default is Coinbase's free public spot endpoint — a $0 pass-through that still
# proves the expense-account wiring. Point at any x402 endpoint to pay for an
# edge (it must be on the allowlist, which is derived from this URL's host).
SIGNAL_URL=
# Per-call / per-day USD caps for signal purchases.
SIGNAL_MAX_USD=0.05
SIGNAL_DAY_USD=1

# ── Agent wallet (pays x402 challenges) ───────────────────────────────────────
# Funded Base burner for paid signals. Leave empty for the free demo (a
# throwaway key — every call is still grant-checked + receipted, just unfunded).
PRIVATE_KEY=

# ── Optional: sync receipts to your yeetful.com dashboard ─────────────────────
YEETFUL_API_KEY=
YEETFUL_GRANT_ID=
# Must be the CANONICAL origin (no redirect), e.g. https://www.yeetful.com
YEETFUL_LEDGER_URL=
