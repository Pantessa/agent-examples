# Copy to .env.local — never commit real keys (there are none here: the desk
# reads a public chain and the visitor's own wallet signs).

# ── Pantessa embed ────────────────────────────────────────────────────────────
# PUBLIC embed key (yfe_…) from https://www.pantessa.com/dashboard/keys.
# Publishable by design (safe in page source): attributes this site's sessions
# to your account (money moved, funnel, dead-ends on /dashboard/embeds) and
# bills house-model answers to YOUR plan instead of each visitor's free tier.
# Leave empty for a keyless embed — everything still works, nothing attributes.
NEXT_PUBLIC_PANTESSA_EMBED_KEY=

# Where the hosted chat lives. Leave unset for production. Point it at a local
# `next start` of the Pantessa website (e.g. http://localhost:3555) to test
# embed changes end-to-end before they deploy.
NEXT_PUBLIC_PANTESSA_ORIGIN=

# ── Robinhood Chain reads ─────────────────────────────────────────────────────
# Optional RPC override (default: the public rpc.mainnet.chain.robinhood.com,
# which rate-limits bursts — the desk batches through Multicall3 for that).
ROBINHOOD_RPC_URL=

# Show a wallet's desk without connecting — read-only "watch" mode is also a
# URL param: /?address=0x…
NEXT_PUBLIC_WATCH_ADDRESS=
